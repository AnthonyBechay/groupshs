generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // "super_admin", "admin", "user"

  // Granular permissions (super_admin always has all)
  canManageUnits       Boolean @default(false) @map("can_manage_units")
  canManageMembers     Boolean @default(false) @map("can_manage_members")
  canManageActivities  Boolean @default(false) @map("can_manage_activities")
  canManageGallery     Boolean @default(false) @map("can_manage_gallery")
  canManagePartners    Boolean @default(false) @map("can_manage_partners")
  canManageSocialLinks Boolean @default(false) @map("can_manage_social_links")
  canManageNews        Boolean @default(false) @map("can_manage_news")
  canViewSubmissions   Boolean @default(false) @map("can_view_submissions")
  canManageSettings    Boolean @default(false) @map("can_manage_settings")
  canManageHistory     Boolean @default(false) @map("can_manage_history")

  // Empty array = access to all units; otherwise restricted to listed unit IDs
  allowedUnitIds String[] @default([]) @map("allowed_unit_ids")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user")
}

// ─── Recruitment ─────────────────────────────────────────────────────────────

model RecruitmentSubmission {
  id                String   @id @default(uuid())
  fullName          String   @map("full_name")
  dateOfBirth       String   @map("date_of_birth")
  schoolLevel       String   @map("school_level")
  memberPhone       String?  @map("member_phone")
  parentWereScouts  Boolean  @map("parent_were_scouts")
  parentScoutGroup  String?  @map("parent_scout_group")
  parentContactInfo String?  @map("parent_contact_info") // legacy combined field
  parentName        String?  @map("parent_name")
  parentPhone       String?  @map("parent_phone")
  siblingsInGroup   Boolean  @map("siblings_in_group")
  siblingNames      String?  @map("sibling_names")
  otherComments     String?  @map("other_comments")
  status            String   @default("PENDING") // PENDING, CONTACTED, WAITING_LIST, RECRUITED, REJECTED
  statusNote        String?  @map("status_note")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("recruitment_submission")
}

// ─── Units ───────────────────────────────────────────────────────────────────

model Unit {
  id          String  @id @default(uuid())
  name        String // e.g. "Louveteaux 1", "Eclaireurs Aigle"
  unitType    String  @map("unit_type") // LOUVETEAUX, ECLAIREURS, ROUTIERS
  description String? // About this unit
  contactName String? @map("contact_name")  // Responsible person name
  contactPhone String? @map("contact_phone") // Responsible person phone
  imageUrl    String? @map("image_url")      // Unit photo

  members    Member[]
  activities Activity[]
  subgroups  Subgroup[]
  contacts   UnitContact[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("unit")
}

// Multiple contact people (members) per unit
model UnitContact {
  id        String @id @default(uuid())
  unitId    String @map("unit_id")
  unit      Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  memberId  String @map("member_id")
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0) @map("sort_order")
  role      String? // optional override label e.g. "Cheftaine Principale"

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([unitId, memberId])
  @@map("unit_contact")
  @@index([unitId])
}

// Sizaine (Louveteaux) / Patrouille (Eclaireurs) / Equipe (Routiers)
model Subgroup {
  id          String  @id @default(uuid())
  name        String
  description String?

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  members Member[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("subgroup")
}

// ─── Members ─────────────────────────────────────────────────────────────────

model Member {
  id          String   @id @default(uuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  dateOfBirth String?  @map("date_of_birth")
  placeOfBirth String? @map("place_of_birth")
  phone       String?
  email       String?
  bloodType   String?  @map("blood_type")
  role        String?
  progressions String[] @default([])
  joinedAt    DateTime @default(now()) @map("joined_at")

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id])

  subgroupId String?   @map("subgroup_id")
  subgroup   Subgroup? @relation(fields: [subgroupId], references: [id], onDelete: SetNull)

  // Address
  city       String?
  street     String?
  building   String?
  floor      String?
  homePhone  String?  @map("home_phone")

  // Family counts
  numberOfBrothers Int? @map("number_of_brothers")
  numberOfSisters  Int? @map("number_of_sisters")

  // Family doctor
  doctorName          String? @map("doctor_name")
  doctorPhone         String? @map("doctor_phone")
  doctorClinicAddress String? @map("doctor_clinic_address")

  // Emergency contact
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactRelation String? @map("emergency_contact_relation")
  emergencyContactPhone    String? @map("emergency_contact_phone")

  // Father
  fatherName       String? @map("father_name")
  fatherPhone      String? @map("father_phone")
  fatherProfession String? @map("father_profession")
  fatherEmail      String? @map("father_email")
  fatherOldScout   String? @map("father_old_scout")

  // Mother
  motherName       String? @map("mother_name")
  motherPhone      String? @map("mother_phone")
  motherProfession String? @map("mother_profession")
  motherEmail      String? @map("mother_email")
  motherOldScout   String? @map("mother_old_scout")

  // Medical
  allergySeasonal   String? @map("allergy_seasonal")
  allergyMedication String? @map("allergy_medication")
  allergyFood       String? @map("allergy_food")
  allergyAnimals    String? @map("allergy_animals")
  chronicIllnesses  String? @map("chronic_illnesses")
  sportsToAvoid     String? @map("sports_to_avoid")
  previousSurgeries String? @map("previous_surgeries")
  antiTetanusDate   String? @map("anti_tetanus_date")

  // Authorization
  legalGuardianName String?   @map("legal_guardian_name")
  consentSignedAt   DateTime? @map("consent_signed_at")

  // Photo
  photoUrl String? @map("photo_url")

  groupSiblings GroupSibling[]
  medications   MemberMedication[]
  moves         MemberMove[]
  unitContacts  UnitContact[]
  attendance    ActivityAttendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("member")
  @@index([unitId])
  @@index([subgroupId])
}

// Brothers/sisters of the member that are also in the group
model GroupSibling {
  id       String  @id @default(uuid())
  memberId String  @map("member_id")
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  name        String
  schoolClass String? @map("school_class")
  unitName    String? @map("unit_name") // free text since may be in another group

  createdAt DateTime @default(now()) @map("created_at")

  @@map("group_sibling")
  @@index([memberId])
}

// Current medication during scouts activities
model MemberMedication {
  id       String  @id @default(uuid())
  memberId String  @map("member_id")
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  startDate  String? @map("start_date")
  endDate    String? @map("end_date")
  name       String
  dosage     String?
  timeToTake String? @map("time_to_take") // e.g. "08:00 am"

  createdAt DateTime @default(now()) @map("created_at")

  @@map("member_medication")
  @@index([memberId])
}

// Move history: unit/subgroup/role transitions
model MemberMove {
  id       String @id @default(uuid())
  memberId String @map("member_id")
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fromUnitId     String? @map("from_unit_id")
  toUnitId       String? @map("to_unit_id")
  fromSubgroupId String? @map("from_subgroup_id")
  toSubgroupId   String? @map("to_subgroup_id")
  fromRole       String? @map("from_role")
  toRole         String? @map("to_role")
  fromProgression String[] @default([]) @map("from_progression")
  toProgression   String[] @default([]) @map("to_progression")

  moveDate DateTime @default(now()) @map("move_date")
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("member_move")
  @@index([memberId])
}

// ─── Activities ──────────────────────────────────────────────────────────────

model Activity {
  id          String @id @default(uuid())
  title       String
  description String
  whatToBring String? @map("what_to_bring")

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id])

  activityType    String  @default("OTHER") @map("activity_type") // CAMP, JOURNEE, TEMPS, MARCHE, OTHER
  startDate       DateTime @map("start_date")
  endDate         DateTime? @map("end_date")
  pickupTime      String?  @map("pickup_time")      // e.g. "08:00"
  dropoffTime     String?  @map("dropoff_time")     // e.g. "17:00"
  pickupLocation  String?  @map("pickup_location")
  dropoffLocation String?  @map("dropoff_location")
  location        String?                            // main activity location

  // Google Maps URLs for the locations above
  pickupLocationUrl  String? @map("pickup_location_url")
  dropoffLocationUrl String? @map("dropoff_location_url")
  locationUrl        String? @map("location_url")

  imageUrl   String?  @map("image_url")
  isUpcoming Boolean  @default(true) @map("is_upcoming") // legacy, kept for compat
  hidden     Boolean  @default(false)                     // hide from public site
  year       Int

  totalDays  Int? @map("total_days") // for partial-attendance computation

  attendance ActivityAttendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("activity")
}

// Per-member attendance for an activity (pre + post)
model ActivityAttendance {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  memberId   String   @map("member_id")
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Pre-activity (confirmation)
  confirmation       String? // CONFIRMED, NOT_COMING, PENDING, PARTIAL
  confirmationDays   Int?    @map("confirmation_days")    // when PARTIAL
  confirmationReason String? @map("confirmation_reason")  // when NOT_COMING
  confirmationNote   String? @map("confirmation_note")

  // Post-activity (actual)
  attended       String? // FULLY, NOT_AT_ALL, PARTIAL
  attendedDays   Int?    @map("attended_days") // when PARTIAL
  attendanceNote String? @map("attendance_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([activityId, memberId])
  @@index([activityId])
  @@index([memberId])
  @@map("activity_attendance")
}

// ─── Site Settings (singleton) ───────────────────────────────────────────────

model SiteSettings {
  id                 String  @id @default("default")
  groupFoundedYear   Int     @default(2014) @map("group_founded_year")
  manualUnitCount    Int?    @map("manual_unit_count")
  manualMemberCount  Int?    @map("manual_member_count")
  logoUrl            String? @map("logo_url")

  // Footer
  footerDescription String? @map("footer_description")
  footerAddress     String? @map("footer_address")
  footerPhone       String? @map("footer_phone")
  footerEmail       String? @map("footer_email")

  // About page hero
  aboutTitle    String? @map("about_title")
  aboutSubtitle String? @map("about_subtitle")
  aboutIntro    String? @map("about_intro")
  aboutMission  String? @map("about_mission")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("site_settings")
}

// Timeline / archive entries for the About page
model AboutSection {
  id          String  @id @default(uuid())
  year        Int?
  dateLabel   String? @map("date_label")
  title       String
  description String?
  imageUrl    String? @map("image_url")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("about_section")
}

// ─── News ────────────────────────────────────────────────────────────────────

model NewsArticle {
  id        String   @id @default(uuid())
  title     String
  summary   String
  content   String?  // optional longer content
  imageUrl  String?  @map("image_url")
  published Boolean  @default(true)
  date      DateTime @default(now())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("news_article")
}

// ─── Gallery ──────────────────────────────────────────────────────────────────

model GalleryPhoto {
  id       String @id @default(uuid())
  imageUrl String @map("image_url")
  caption  String?
  sortOrder Int   @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("gallery_photo")
}

// ─── Partners & Sponsors ─────────────────────────────────────────────────────

model Partner {
  id          String  @id @default(uuid())
  name        String
  description String?
  logoUrl     String  @map("logo_url")
  websiteUrl  String? @map("website_url")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("partner")
}

// ─── History ─────────────────────────────────────────────────────────────────

model HistoryMilestone {
  id              String   @id @default(uuid())
  date            DateTime
  title           String
  description     String?                         // Short caption shown in the timeline
  longDescription String?  @map("long_description") // Full story / detailed account
  challenges      String?                         // Obstacles & challenges faced
  motivations     String?                         // What drove this milestone
  unitCount       Int?     @map("unit_count")
  memberCount     Int?     @map("member_count")
  imageUrls       String[] @default([]) @map("image_urls")
  sortOrder       Int      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("history_milestone")
}

// Old members of the group (private — admin-only visibility)
model Ancien {
  id          String  @id @default(uuid())
  name        String
  lastRole    String  @map("last_role")
  yearsActive String? @map("years_active") // e.g. "2014–2018"
  photoUrl    String? @map("photo_url")
  bio         String?
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ancien")
}

// ─── Social Links ────────────────────────────────────────────────────────────

model SocialLink {
  id        String @id @default(uuid())
  platform  String // instagram, youtube, anghami, facebook, tiktok, etc.
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("social_link")
}
