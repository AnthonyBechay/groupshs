generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // "super_admin", "admin", "user"

  // Granular permissions (super_admin always has all)
  canManageUnits       Boolean @default(false) @map("can_manage_units")
  canManageMembers     Boolean @default(false) @map("can_manage_members")
  canManageActivities  Boolean @default(false) @map("can_manage_activities")
  canManageGallery     Boolean @default(false) @map("can_manage_gallery")
  canManagePartners    Boolean @default(false) @map("can_manage_partners")
  canManageSocialLinks Boolean @default(false) @map("can_manage_social_links")
  canManageNews        Boolean @default(false) @map("can_manage_news")
  canViewSubmissions   Boolean @default(false) @map("can_view_submissions")
  canManageSettings    Boolean @default(false) @map("can_manage_settings")
  canManageHistory     Boolean @default(false) @map("can_manage_history")
  // Move Up / Maîtrise / Leaving. Separate from canManageMembers because moving
  // members between branches is a group-level decision, not day-to-day editing.
  canManageTransitions Boolean @default(false) @map("can_manage_transitions")
  // Stock: equipment, food, uniforms and badges. Unrestricted = the group's
  // storekeeper (locations, catalog, processing requests); restricted to units
  // = looks after those units' own gear only.
  canManageStock       Boolean @default(false) @map("can_manage_stock")
  // Sees every unit's uniform/badge requests and the QG shopping list, and may
  // mark them bought — for whoever goes to the QG for everyone. Does not give
  // access to other units' members, nor let them approve those units' orders.
  canSeeAllRequests    Boolean @default(false) @map("can_see_all_requests")

  // Empty array = access to all units; otherwise restricted to listed unit IDs
  allowedUnitIds String[] @default([]) @map("allowed_unit_ids")

  // The person behind the account, when there is one. Optional so existing
  // accounts keep working. It says WHO they are (a CM of the Meute…) and drives
  // the "My unit" view; it never grants access by itself — permissions and
  // allowedUnitIds above still decide what they may touch.
  memberId String?  @unique @map("member_id")
  member   Member?  @relation("UserMember", fields: [memberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user")
}

// ─── Recruitment ─────────────────────────────────────────────────────────────

model RecruitmentSubmission {
  id                String   @id @default(uuid())
  fullName          String   @map("full_name")
  gender            String?  // MALE, FEMALE
  dateOfBirth       String   @map("date_of_birth")
  schoolLevel       String   @map("school_level")
  memberPhone       String?  @map("member_phone")
  parentWereScouts  Boolean  @map("parent_were_scouts")
  parentScoutGroup  String?  @map("parent_scout_group")
  parentContactInfo String?  @map("parent_contact_info") // legacy combined field
  parentName        String?  @map("parent_name")
  parentPhone       String?  @map("parent_phone")
  siblingsInGroup   Boolean  @map("siblings_in_group")
  siblingNames      String?  @map("sibling_names")
  otherComments     String?  @map("other_comments")
  status            String   @default("PENDING") // PENDING, CONTACTED, WAITING_LIST, RECRUITED, REJECTED
  statusNote        String?  @map("status_note")

  // Set when the applicant has been enrolled as a real Member in a unit — the
  // final step of recruitment. Until then a "RECRUITED" status is just a label.
  // A real relation, so deleting the member cannot leave this pointing at a
  // ghost id (which made "Open member" 404).
  memberId   String?   @unique @map("member_id")
  member     Member?   @relation("RecruitedMember", fields: [memberId], references: [id], onDelete: SetNull)
  enrolledAt DateTime? @map("enrolled_at")

  createdAt         DateTime @default(now()) @map("created_at")

  @@map("recruitment_submission")
  // The admin list is always newest-first, usually narrowed by status.
  @@index([status, createdAt])
  @@index([createdAt])
}

// ─── Units ───────────────────────────────────────────────────────────────────

model Unit {
  id          String  @id @default(uuid())
  name        String // e.g. "Louveteaux 1", "Eclaireurs Aigle"
  unitType    String  @map("unit_type") // LOUVETEAUX, ECLAIREURS, ROUTIERS
  description String? // About this unit
  contactName String? @map("contact_name")  // Responsible person name
  contactPhone String? @map("contact_phone") // Responsible person phone
  imageUrl    String? @map("image_url")      // Unit photo

  members    Member[]   @relation("UnitMembers")
  maitrise   Member[]   @relation("UnitMaitrise")  // leaders serving this unit from elsewhere
  stockItems   StockItem[]
  itemRequests ItemRequest[]
  activities Activity[]
  subgroups  Subgroup[]
  contacts   UnitContact[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("unit")
}

// Multiple contact people (members) per unit
model UnitContact {
  id        String @id @default(uuid())
  unitId    String @map("unit_id")
  unit      Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  memberId  String @map("member_id")
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0) @map("sort_order")
  role      String? // optional override label e.g. "Cheftaine Principale"

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([unitId, memberId])
  @@map("unit_contact")
  @@index([unitId])
}

// Sizaine (Louveteaux) / Patrouille (Eclaireurs) / Equipe (Routiers)
model Subgroup {
  id          String  @id @default(uuid())
  name        String
  description String?

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  members    Member[]
  stockItems StockItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("subgroup")
}

// ─── Members ─────────────────────────────────────────────────────────────────

model Member {
  id          String   @id @default(uuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  gender      String?  // MALE, FEMALE
  dateOfBirth String?  @map("date_of_birth")
  placeOfBirth String? @map("place_of_birth")
  phone       String?
  email       String?
  bloodType   String?  @map("blood_type")
  role        String?
  // Concurrent roles. Normally empty, but the group does make exceptions —
  // someone can be a CM (unit maitrise) and an ACG (conseil) at the same time.
  extraRoles  String[] @default([]) @map("extra_roles")
  progressions String[] @default([])
  joinedAt    DateTime @default(now()) @map("joined_at")

  // Home unit — where the member actually belongs. Unit maitrise (CT, CM, CC…)
  // stay members of the Routiers / Pionnieres while they run a younger unit.
  unitId String @map("unit_id")
  unit   Unit   @relation("UnitMembers", fields: [unitId], references: [id])

  // The unit this leader runs, when it differs from their home unit.
  servesUnitId String? @map("serves_unit_id")
  servesUnit   Unit?   @relation("UnitMaitrise", fields: [servesUnitId], references: [id], onDelete: SetNull)

  subgroupId String?   @map("subgroup_id")
  subgroup   Subgroup? @relation(fields: [subgroupId], references: [id], onDelete: SetNull)

  // Address
  city       String?
  street     String?
  building   String?
  floor      String?
  homePhone  String?  @map("home_phone")

  // Family counts
  numberOfBrothers Int? @map("number_of_brothers")
  numberOfSisters  Int? @map("number_of_sisters")

  // Family doctor
  doctorName          String? @map("doctor_name")
  doctorPhone         String? @map("doctor_phone")
  doctorClinicAddress String? @map("doctor_clinic_address")

  // Emergency contact
  emergencyContactName     String? @map("emergency_contact_name")
  emergencyContactRelation String? @map("emergency_contact_relation")
  emergencyContactPhone    String? @map("emergency_contact_phone")

  // Father
  fatherName       String? @map("father_name")
  fatherPhone      String? @map("father_phone")
  fatherProfession String? @map("father_profession")
  fatherEmail      String? @map("father_email")
  fatherOldScout   String? @map("father_old_scout")

  // Mother
  motherName       String? @map("mother_name")
  motherPhone      String? @map("mother_phone")
  motherProfession String? @map("mother_profession")
  motherEmail      String? @map("mother_email")
  motherOldScout   String? @map("mother_old_scout")

  // Medical
  allergySeasonal   String? @map("allergy_seasonal")
  allergyMedication String? @map("allergy_medication")
  allergyFood       String? @map("allergy_food")
  allergyAnimals    String? @map("allergy_animals")
  chronicIllnesses  String? @map("chronic_illnesses")
  sportsToAvoid     String? @map("sports_to_avoid")
  previousSurgeries String? @map("previous_surgeries")
  antiTetanusDate   String? @map("anti_tetanus_date")

  // Authorization
  legalGuardianName String?   @map("legal_guardian_name")
  consentSignedAt   DateTime? @map("consent_signed_at")

  // Photo
  photoUrl String? @map("photo_url")

  // ─── Lifecycle ─────────────────────────────────────────────────────────────
  // ACTIVE members appear on rosters. LEFT members have departed the group —
  // they ARE the anciens. Nothing is ever hard deleted, so their history,
  // attendance and medical file stay intact.
  status   String    @default("ACTIVE")          // ACTIVE | LEFT
  leftAt   DateTime? @map("left_at")
  leftNote String?   @map("left_note")
  ancienId String?   @map("ancien_id")           // legacy link to the old `ancien` table

  // ─── Ancien profile ────────────────────────────────────────────────────────
  // Shown on the public Anciens section once the member has left. These live on
  // the member rather than in a parallel table, so a former member is one
  // record: their file, their history and their alumni profile together.
  bio               String?
  professions       Json     @default("[]")                      // [{title,organization,url,details}]
  scoutRolesHistory Json     @default("[]") @map("scout_roles_history") // [{role,startYear,endYear}]
  ancienSortOrder   Int      @default(0) @map("ancien_sort_order")
  hiddenFromAnciens Boolean  @default(false) @map("hidden_from_anciens")

  groupSiblings GroupSibling[]
  medications   MemberMedication[]
  moves         MemberMove[]
  recruitment   RecruitmentSubmission? @relation("RecruitedMember")
  unitContacts  UnitContact[]
  attendance    ActivityAttendance[]
  user          User?                 @relation("UserMember")
  updateRequests MemberUpdateRequest[]
  changes        MemberChange[]
  itemRequests   ItemRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("member")
  @@index([unitId])
  @@index([subgroupId])
  @@index([status])
  @@index([servesUnitId])
}

// A link sent to a family so they fill in the member's file themselves
// (contacts, doctor, allergies, treatment). What they send is only a proposal:
// a leader of the unit reviews it and chooses what to apply. Nothing a family
// types ever reaches the member record without that review.
model MemberUpdateRequest {
  id       String @id @default(uuid())
  memberId String @map("member_id")
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Kept in clear, unlike a password, so a leader can copy the link again to
  // resend it. A leaked token can only PROPOSE changes, which still need review.
  token     String   @unique
  status    String   @default("OPEN") // OPEN | SUBMITTED | APPROVED | REJECTED | REVOKED
  expiresAt DateTime @map("expires_at")
  sentTo    String?  @map("sent_to") // who it went to, e.g. "Mother"

  createdById   String? @map("created_by_id")
  createdByName String? @map("created_by_name")

  openedAt    DateTime? @map("opened_at")
  submittedAt DateTime? @map("submitted_at")
  submittedBy String?   @map("submitted_by") // the name the family typed
  changes     Json      @default("{}")       // { fields: {key: value}, medications?: [...] }

  reviewedById   String?   @map("reviewed_by_id")
  reviewedByName String?   @map("reviewed_by_name")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewNote     String?   @map("review_note")
  appliedFields  String[]  @default([]) @map("applied_fields")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([memberId])
  @@index([status])
  @@map("member_update_request")
}

// One changed field on a member's file: who changed it, from what, to what.
// Written by every path that edits personal details — the member form, the
// treatment and sibling lists, and a family submission when a leader applies
// it — so "who changed the allergies, and when?" always has an answer.
// Unit / role / progression moves have their own history in MemberMove.
model MemberChange {
  id       String @id @default(uuid())
  memberId String @map("member_id")
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  field    String            // a member column, or "medications" / "siblings"
  oldValue String? @map("old_value")
  newValue String? @map("new_value")

  source        String  @default("ADMIN")  // ADMIN | FAMILY
  changedById   String? @map("changed_by_id")
  changedByName String? @map("changed_by_name")
  requestId     String? @map("request_id")  // the family submission, when FAMILY

  createdAt DateTime @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@map("member_change")
}

// Brothers/sisters of the member that are also in the group
model GroupSibling {
  id       String  @id @default(uuid())
  memberId String  @map("member_id")
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  name        String
  schoolClass String? @map("school_class")
  unitName    String? @map("unit_name") // free text since may be in another group

  createdAt DateTime @default(now()) @map("created_at")

  @@map("group_sibling")
  @@index([memberId])
}

// Current medication during scouts activities
model MemberMedication {
  id       String  @id @default(uuid())
  memberId String  @map("member_id")
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  startDate  String? @map("start_date")
  endDate    String? @map("end_date")
  name       String
  dosage     String?
  timeToTake String? @map("time_to_take") // e.g. "08:00 am"

  createdAt DateTime @default(now()) @map("created_at")

  @@map("member_medication")
  @@index([memberId])
}

// Move history: unit/subgroup/role transitions
model MemberMove {
  id       String @id @default(uuid())
  memberId String @map("member_id")
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fromUnitId     String? @map("from_unit_id")
  toUnitId       String? @map("to_unit_id")
  fromSubgroupId String? @map("from_subgroup_id")
  toSubgroupId   String? @map("to_subgroup_id")
  fromRole       String? @map("from_role")
  toRole         String? @map("to_role")
  fromProgression String[] @default([]) @map("from_progression")
  toProgression   String[] @default([]) @map("to_progression")

  // Maîtrise transfers also change the extra roles and the unit served. Older
  // moves never recorded them, so a revert only restores them when this is set.
  leadershipSnapshot Boolean  @default(false) @map("leadership_snapshot")
  fromExtraRoles     String[] @default([]) @map("from_extra_roles")
  toExtraRoles       String[] @default([]) @map("to_extra_roles")
  fromServesUnitId   String?  @map("from_serves_unit_id")
  toServesUnitId     String?  @map("to_serves_unit_id")

  moveDate DateTime @default(now()) @map("move_date")
  notes    String?

  // ─── Batch transition tracking (age-based promotions) ───────────────────────
  // Moves executed together by the transition engine share a batchId so the
  // whole promotion can be reverted as one unit ("reverse engine").
  batchId     String?   @map("batch_id")
  batchLabel  String?   @map("batch_label")   // e.g. "Louveteaux 1 → Eclaireurs Aigle (2026–2027)"
  revertedAt  DateTime? @map("reverted_at")   // set when this move has been rolled back
  revertedBy  String?   @map("reverted_by")   // user id that performed the revert

  createdAt DateTime @default(now()) @map("created_at")

  @@map("member_move")
  @@index([memberId])
  @@index([batchId])
}

// ─── Activities ──────────────────────────────────────────────────────────────

model Activity {
  id          String @id @default(uuid())
  title       String
  description String
  whatToBring String? @map("what_to_bring")

  unitId String @map("unit_id")
  unit   Unit   @relation(fields: [unitId], references: [id])

  activityType    String  @default("OTHER") @map("activity_type") // CAMP, JOURNEE, TEMPS, MARCHE, OTHER
  startDate       DateTime @map("start_date")
  endDate         DateTime? @map("end_date")
  pickupTime      String?  @map("pickup_time")      // e.g. "08:00"
  dropoffTime     String?  @map("dropoff_time")     // e.g. "17:00"
  pickupLocation  String?  @map("pickup_location")
  dropoffLocation String?  @map("dropoff_location")
  location        String?                            // main activity location

  // Google Maps URLs for the locations above
  pickupLocationUrl  String? @map("pickup_location_url")
  dropoffLocationUrl String? @map("dropoff_location_url")
  locationUrl        String? @map("location_url")

  imageUrl   String?  @map("image_url")
  isUpcoming Boolean  @default(true) @map("is_upcoming") // legacy, kept for compat
  hidden     Boolean  @default(false)                     // hide from public site
  year       Int

  totalDays  Int? @map("total_days") // for partial-attendance computation

  // Printed on the circular sent to parents. Free text on purpose: a fee is
  // written "$25" or "500,000 LL", never computed with.
  theme String?
  fee   String?

  // A weekly reunion is ONE activity with many sessions. startDate is the first
  // session; it repeats every week up to and including recurrenceUntil.
  // Null recurrence = a one-off, which still has exactly one session, so
  // programme and attendance always live on a session.
  recurrence      String?   // WEEKLY
  recurrenceUntil DateTime? @map("recurrence_until")

  sessions   ActivitySession[]
  attendance ActivityAttendance[]
  circulars  Circular[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("activity")
}

// One occurrence of an activity: a given Saturday's reunion, or the single
// session of a camp. What differs from week to week — the programme, the
// attendance, a cancellation — lives here, never on the activity.
model ActivitySession {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  date         DateTime                         // the day, at UTC midnight like Activity.startDate
  status       String   @default("SCHEDULED")   // SCHEDULED | CANCELLED
  cancelReason String?  @map("cancel_reason")
  programme    Json     @default("[]")          // [{time,title,details,by}] — see src/lib/activity-sessions.ts
  notes        String?

  attendance ActivityAttendance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([activityId, date])
  @@index([date])
  @@map("activity_session")
}

// Per-member attendance for one session (pre + post)
model ActivityAttendance {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sessionId  String          @map("session_id")
  session    ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId   String   @map("member_id")
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Pre-activity (confirmation)
  confirmation       String? // CONFIRMED, NOT_COMING, PENDING, PARTIAL
  confirmationDays   Int?    @map("confirmation_days")    // when PARTIAL
  confirmationReason String? @map("confirmation_reason")  // when NOT_COMING
  confirmationNote   String? @map("confirmation_note")

  // Post-activity (actual)
  attended       String? // FULLY, NOT_AT_ALL, PARTIAL
  attendedDays   Int?    @map("attended_days") // when PARTIAL
  attendanceNote String? @map("attendance_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([sessionId, memberId])
  @@index([activityId])
  @@index([memberId])
  @@map("activity_attendance")
}

// A circular (letter to parents) generated for an activity.
//
// `seq` is the running number in the reference ("06" in 06/24-25/MeuteHathi).
// It is shared by the WHOLE group within a scout year — not per unit — so two
// units can never issue the same number. The unique index is what guarantees
// that under concurrent creation; the API retries on a collision.
model Circular {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  scoutYear Int      @map("scout_year") // calendar year the scout year starts in
  seq       Int
  // Set only when the reference was typed by hand; otherwise it is derived
  // from seq + scoutYear + unit name so a renamed unit stays consistent.
  referenceOverride String? @map("reference_override")

  template  String                      // key of the template it started from
  title     String                      // label in the admin list only
  issueDate DateTime @map("issue_date") // the date printed on the letter
  content   Json                        // CircularContent — see src/lib/circular/types.ts

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([scoutYear, seq])
  @@index([activityId])
  @@map("circular")
}

// ─── Site Settings (singleton) ───────────────────────────────────────────────

model SiteSettings {
  id                 String  @id @default("default")
  groupFoundedYear   Int     @default(2014) @map("group_founded_year")
  manualUnitCount    Int?    @map("manual_unit_count")
  manualMemberCount  Int?    @map("manual_member_count")
  manualActivityCount Int?   @map("manual_activity_count")
  logoUrl            String? @map("logo_url")

  // ─── Age-based branch transitions ──────────────────────────────────────────
  // A member moves up when they reach the threshold age during the fiscal year.
  // Boys' and girls' tracks are configured independently.
  fiscalYearStartMonth       Int @default(9)  @map("fiscal_year_start_month")        // 1-12
  ageLouveteauxToEclaireurs  Int @default(12) @map("age_louveteaux_to_eclaireurs")   // boys
  ageEclaireursToRoutiers    Int @default(17) @map("age_eclaireurs_to_routiers")     // boys
  ageLouvettesToEclaireuses  Int @default(12) @map("age_louvettes_to_eclaireuses")   // girls
  ageEclaireusesToPionnieres Int @default(17) @map("age_eclaireuses_to_pionnieres")  // girls

  // ─── Circular letterhead ───────────────────────────────────────────────────
  // Left logo is the association's, centre is `logoUrl`, right is the unit's.
  associationLogoUrl String? @map("association_logo_url")
  circularStampUrl   String? @map("circular_stamp_url")
  circularGroupName  String? @map("circular_group_name") // under the centre logo
  circularCity       String? @map("circular_city")       // dateline: "Ain Saadeh, July 3, 2025"
  circularMotto      String? @map("circular_motto")      // the year's motto, page footer

  // Footer
  footerDescription String? @map("footer_description")
  footerAddress     String? @map("footer_address")
  footerPhone       String? @map("footer_phone")
  footerEmail       String? @map("footer_email")

  // About page hero
  aboutTitle    String? @map("about_title")
  aboutSubtitle String? @map("about_subtitle")
  aboutIntro    String? @map("about_intro")
  aboutMission  String? @map("about_mission")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("site_settings")
}

// Timeline / archive entries for the About page
model AboutSection {
  id          String  @id @default(uuid())
  year        Int?
  dateLabel   String? @map("date_label")
  title       String
  description String?
  imageUrl    String? @map("image_url")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("about_section")
}

// ─── News ────────────────────────────────────────────────────────────────────

model NewsArticle {
  id        String   @id @default(uuid())
  title     String
  summary   String
  content   String?  // optional longer content
  imageUrl  String?  @map("image_url")
  published Boolean  @default(true)
  date      DateTime @default(now())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("news_article")
}

// ─── Gallery ──────────────────────────────────────────────────────────────────

model GalleryPhoto {
  id       String @id @default(uuid())
  imageUrl String @map("image_url")
  caption  String?
  sortOrder Int   @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("gallery_photo")
}

// ─── Partners & Sponsors ─────────────────────────────────────────────────────

model Partner {
  id          String  @id @default(uuid())
  name        String
  description String?
  logoUrl     String  @map("logo_url")
  websiteUrl  String? @map("website_url")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("partner")
}

// ─── History ─────────────────────────────────────────────────────────────────

model HistoryMilestone {
  id              String   @id @default(uuid())
  type            String   @default("milestone")    // "milestone" | "achievement"
  date            DateTime
  title           String
  description     String?                           // Short caption shown in the timeline
  longDescription String?  @map("long_description") // Full story / detailed account
  challenges      String?                           // Obstacles & challenges faced (one per line)
  motivations     String?                           // What drove this (one per line)
  unitCount       Int?     @map("unit_count")
  memberCount     Int?     @map("member_count")
  imageUrls       String[] @default([]) @map("image_urls")
  sortOrder       Int      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("history_milestone")
}

// Old members of the group (private — admin-only visibility)
model Ancien {
  id          String   @id @default(uuid())
  name        String
  joinedYear  Int?     @map("joined_year")      // year they joined scouting
  leftYear    Int?     @map("left_year")         // year they left scouting
  progression String[]                           // ["Premiere veille", "Depart"]
  // [{role,startYear,endYear}] – all scout roles held, ordered chronologically
  scoutRoles  Json     @default("[]") @map("scout_roles")
  // [{title,organization,url,details}] – current real-life professions
  professions Json     @default("[]")
  phone       String?
  email       String?
  photoUrl    String?  @map("photo_url")
  bio         String?
  sortOrder   Int      @default(0) @map("sort_order")

  // Set when this Ancien was generated by the "leave the group" flow, so the
  // departure can be reverted (member reactivated, Ancien removed).
  sourceMemberId String? @unique @map("source_member_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ancien")
}

// ─── Social Links ────────────────────────────────────────────────────────────

model SocialLink {
  id        String @id @default(uuid())
  platform  String // instagram, youtube, anghami, facebook, tiktok, etc.
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("social_link")
}

// ─── Stock ───────────────────────────────────────────────────────────────────

// Where things are kept: a room, and the shelves inside it (one level down).
model StorageLocation {
  id       String            @id @default(uuid())
  name     String
  parentId String?           @map("parent_id")
  parent   StorageLocation?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children StorageLocation[] @relation("LocationTree")
  notes    String?
  sortOrder Int              @default(0) @map("sort_order")

  items StockItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([parentId])
  @@map("storage_location")
}

// Anything the group keeps: a tent, a pot, rice, scarves, badges.
// Ownership is explicit: no unit = the group's; a unit, optionally narrowed to
// one of its sub-groups (an équipe's own kit).
model StockItem {
  id          String  @id @default(uuid())
  name        String
  category    String  // see STOCK_CATEGORIES in src/lib/stock.ts
  description String?

  quantity      Int     @default(0)
  unitOfMeasure String  @default("pcs") @map("unit_of_measure")
  minQuantity   Int?    @map("min_quantity")   // below this, it shows as running low
  condition     String  @default("GOOD")       // NEW | GOOD | WORN | TO_REPAIR | DAMAGED | LOST
  expiresAt     DateTime? @map("expires_at")   // food

  unitId     String?          @map("unit_id")
  unit       Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  subgroupId String?          @map("subgroup_id")
  subgroup   Subgroup?        @relation(fields: [subgroupId], references: [id], onDelete: SetNull)
  locationId String?          @map("location_id")
  location   StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Part of the catalog leaders can request for a scout (uniform, badges…),
  // usually bought from the QG on demand, sometimes handed out from stock.
  requestable Boolean  @default(false)
  variants    String[] @default([])   // sizes or options to choose from
  price       String?                 // legacy free text; costPrice / sellPrice replace it
  costPrice   Decimal? @map("cost_price") @db.Decimal(12, 2)  // what the group pays at the QG
  sellPrice   Decimal? @map("sell_price") @db.Decimal(12, 2)  // what a family pays
  currency    String   @default("USD")                        // USD | LBP
  // Which branches it is for: a Louveteau's shirt is not a Troupe's. Empty =
  // common to every scout (a scarf, a group badge).
  forUnitTypes String[] @default([]) @map("for_unit_types")

  photoUrl String? @map("photo_url")
  notes    String?
  archived Boolean @default(false)

  movements StockMovement[]
  requests  ItemRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([category])
  @@index([unitId])
  @@index([locationId])
  @@map("stock_item")
}

// Every change of quantity, so a count that looks wrong can be explained.
model StockMovement {
  id            String    @id @default(uuid())
  itemId        String    @map("item_id")
  item          StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  delta         Int
  quantityAfter Int       @map("quantity_after")
  reason        String?
  requestId     String?   @map("request_id")
  byId          String?   @map("by_id")
  byName        String?   @map("by_name")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@map("stock_movement")
}

// A leader asks for a catalog item for one scout (or for the unit itself):
// REQUESTED → APPROVED → ORDERED (bought at the QG) → READY → DELIVERED,
// or REJECTED / CANCELLED. Handing it out from stock jumps to DELIVERED.
model ItemRequest {
  id       String    @id @default(uuid())
  itemId   String    @map("item_id")
  item     StockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unitId   String    @map("unit_id")
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  memberId String?   @map("member_id")
  member   Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  variant  String?
  quantity Int     @default(1)
  note     String?

  status     String  @default("REQUESTED")
  fromStock  Boolean @default(false) @map("from_stock")
  statusNote String? @map("status_note")

  // LEADER: asked by the unit's maîtrise (starts approved).
  // FAMILY: ordered by parents on the public page (waits for the maîtrise).
  source           String  @default("LEADER")
  requestedForName String? @map("requested_for_name") // the child, when not matched to a member
  contactName      String? @map("contact_name")
  contactPhone     String? @map("contact_phone")
  orderRef         String? @map("order_ref")          // lines sent together share it
  // The selling price when it was asked, so totals do not move with the catalog.
  unitPrice        Decimal? @map("unit_price") @db.Decimal(12, 2)
  currency         String?
  // Whether the family has paid the unit for it. Independent of the status:
  // some pay when ordering, some when the item is handed over.
  paid             Boolean   @default(false)
  paidAt           DateTime? @map("paid_at")

  requestedById   String? @map("requested_by_id")
  requestedByName String? @map("requested_by_name")
  handledByName   String? @map("handled_by_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@index([unitId])
  @@index([itemId])
  @@index([orderRef])
  @@map("item_request")
}
